# Bu faylı .env.local adı ilə köçürün və dəyərləri doldurun.

# Turso (libSQL)
TURSO_DATABASE_URL=libsql://<db>-<org>.<region>.turso.io
TURSO_AUTH_TOKEN=

# Auth.js — `openssl rand -base64 33` ilə yaradın
AUTH_SECRET=
# Vercel-dən kənarda (məs. `next start` lokal) lazımdır
AUTH_TRUST_HOST=true

# Google OAuth — boş qalarsa Google düyməsi göstərilmir
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tətbiqin ictimai ünvanı (e-poçt linkləri üçün)
APP_URL=http://localhost:3000

# E-poçt: console (inkişaf — məktub terminala yazılır). Real provayder sonra.
EMAIL_PROVIDER=console
EMAIL_FROM="[BRAND ADI] <no-reply@brand.az>"

# CAPTCHA: none (provayder sonra seçiləcək)
CAPTCHA_PROVIDER=none

# 18 yaşdan kiçiklər üçün valideyn addımı (hüquqşünasla dəqiqləşənə qədər söndürülüb)
FEATURE_GUARDIAN_CONSENT=false

# Brend linkləri (boşdursa "#")
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Sonrakı mərhələlər
CRON_SECRET=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Ödəniş: mock (yalnız inkişafda — düymə ödənişi təqlid edir) və ya epoint.
# Epoint kabinetində: uğurlu — {APP_URL}/success, uğursuz — {APP_URL}/error, nəticə (result_url) — {APP_URL}/result
# (success / error ünvanları hər sorğuda sifariş nömrəsi ilə də göndərilir: /success?o=…, /error?o=…)
PAYMENT_PROVIDER=mock
EPOINT_PUBLIC_KEY=
EPOINT_PRIVATE_KEY=
